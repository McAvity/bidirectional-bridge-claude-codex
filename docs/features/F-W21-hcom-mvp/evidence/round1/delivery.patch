diff --git a/tags.py b/tags.py
index 369308c..5dc13df 100644
--- a/tags.py
+++ b/tags.py
@@ -1,2 +1,10 @@
 def normalize_tags(values):
-    raise NotImplementedError("Implement the contract")
+    """Strip whitespace, drop empty values, dedupe keeping first occurrence."""
+    seen = set()
+    result = []
+    for value in values:
+        tag = value.strip()
+        if tag and tag not in seen:
+            seen.add(tag)
+            result.append(tag)
+    return result
diff --git a/tests/test_tags.py b/tests/test_tags.py
index 7cb4c01..330066b 100644
--- a/tests/test_tags.py
+++ b/tests/test_tags.py
@@ -4,3 +4,18 @@ from tags import normalize_tags
 class TagTests(unittest.TestCase):
     def test_public_example(self):
         self.assertEqual(normalize_tags([" A ", "", "B", "A"]), ["A", "B"])
+
+    def test_empty_input(self):
+        self.assertEqual(normalize_tags([]), [])
+
+    def test_all_whitespace_values(self):
+        self.assertEqual(normalize_tags(["", " ", "\t", "\n  "]), [])
+
+    def test_stable_order(self):
+        self.assertEqual(normalize_tags(["c", " b", "a "]), ["c", "b", "a"])
+
+    def test_nonconsecutive_duplicates(self):
+        self.assertEqual(normalize_tags(["x", "y", " x ", "z", "y"]), ["x", "y", "z"])
+
+    def test_case_sensitive(self):
+        self.assertEqual(normalize_tags(["A", "a", " A"]), ["A", "a"])
