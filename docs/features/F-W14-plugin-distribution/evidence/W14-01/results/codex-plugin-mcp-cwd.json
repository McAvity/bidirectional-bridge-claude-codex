  "conclusion": "Codex 0.154.0 gives a plugin-declared MCP server no supported channel for the project or worktree directory: cwd resolves inside the version-pinned plugin cache, the environment is stripped to an allowlist, `env_vars` only re-exports whatever the parent process had, and the MCP initialize handshake advertises no roots capability.",
  "findings": {
    "PWD_absent_when_parent_does_not_export_it": true,
    "PWD_diverges_from_codex_working_root_with_--cd": true,
    "env_is_stripped_without_env_vars": true,
    "env_vars_PWD_forwards_the_parent_PWD_verbatim": true,
    "every_session_was_model_free": true,
    "mcp_initialize_carries_no_roots_capability": true,
    "server_cwd_is_never_the_project": true,
    "stale_parent_PWD_points_at_a_foreign_repository": true,
    "workspace_root_recoverable_only_when_parent_PWD_is_the_worktree": true
  },
